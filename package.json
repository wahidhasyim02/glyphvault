{
  "name": "iconix",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node ./scripts/sync-all-icons.mjs && node ./scripts/enrich-all-tags.mjs",
    "bundle": "node ./scripts/sync-all-icons.mjs && node ./scripts/enrich-all-tags.mjs && node ./scripts/bundle-icons.mjs",
    "dev": "npm run bundle && nuxt dev --port 3000 --host 0.0.0.0",
    "build": "npm run bundle && nuxt build",
    "generate": "npm run bundle && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "node ./scripts/use-rollup-wasm.js && nuxt prepare"
  },
  "dependencies": {
    "@rollup/wasm-node": "^4.68.5",
    "lucide-vue-next": "^0.475.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.13.1",
    "nuxt": "^3.15.4",
    "tailwindcss": "^3.4.17",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
